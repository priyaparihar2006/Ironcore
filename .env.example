# Merge these settings into your private .env. Do not overwrite an existing .env.
# Minimum setup: DATABASE_URL and a generated JWT_SECRET.
# Never commit credentials or put secrets in VITE_ variables (public browser values).

# --- Required: database and authentication ---

# Copy the PostgreSQL URI from your database provider. The current client requires TLS.
# For Supabase, copy your project's Session pooler URI with its exact host/port.
# URL-encode password characters such as @ (%40).
# Example shape (replace every placeholder):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DATABASE_URL=

# Required in production; recommended in development for stable login sessions.
# Generate a secret with the command below, then paste its output after JWT_SECRET=:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use your own generated 96-character hex value, never a shared sample secret.
JWT_SECRET=

# --- Runtime and initial data ---

# npm run dev sets development; npm start sets production automatically.
# Leave NODE_ENV out of .env for these scripts to avoid Vite's production warning.
# For custom production launches, set NODE_ENV=production in the host environment.
# NODE_ENV=production
PORT=5000

# Set true only for an isolated demo database to create demo accounts/data.
# Seeds only an empty database. Demo accounts have published passwords.
# With false, provision an admin and membership plans separately.
# Current public registration requires a membership plan with ID plan_basic.
SEED_DEMO_DATA=false

# --- Frontend/backend URLs ---

# Empty for the combined app or same-origin hosting.
# Separate deployment example: VITE_API_URL=https://ironcore-api.example.com
# Use the backend origin without /api. Rebuild the frontend after changing this.
VITE_API_URL=

# Comma-separated frontend origins, without paths or trailing slashes.
# Local example below; replace it with your frontend origins in production.
# Production example: CORS_ORIGIN=https://ironcore.example.com,https://www.ironcore.example.com
# When omitted, the current server defaults to allowing all origins.
CORS_ORIGIN=http://localhost:5000,http://localhost:5173

# Optional: true disables Vite hot module replacement/file watching.
DISABLE_HMR=false

# --- Optional: avatar uploads ---

# Required only for profile photo uploads. Create a PUBLIC Supabase bucket named
# avatars. Use the project URL and private service_role key from project settings.
# The public anon key is not a replacement for the server service_role key.
# Example: SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=
# Example shape: SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: AI wellness and food lookup ---

# Manual tracking and calculated reports work with AI disabled.
# To enable: choose a provider endpoint/API format, model, key and pricing mode,
# then set true. Users must also provide AI consent. One active model at a time;
# restart the backend after changing these settings. No automatic paid fallback.
AI_ENABLED=false
# responses (default/legacy OpenAI) or chat_completions (compatible providers).
AI_API_FORMAT=responses
# json_schema (default), or prompt_json for chat models without schema support.
# Both validate returned JSON locally; prompt_json can be less reliable.
AI_OUTPUT_MODE=json_schema
# API base URL, including its version prefix, WITHOUT /responses or /chat/completions.
# HTTPS required except for localhost/127.0.0.1/[::1]. No query strings/credentials.
AI_BASE_URL=https://api.openai.com/v1
# Example shape: AI_MODEL=YOUR_SUPPORTED_MODEL_ID
# Prefer models supporting strict JSON Schema; use prompt_json when unsupported.
# Native Anthropic/Gemini API formats are not supported; use compatible endpoints.
AI_MODEL=
# Example shape: AI_API_KEY=YOUR_PRIVATE_PROVIDER_API_KEY
AI_API_KEY=
# Used preferentially ONLY when AI_BASE_URL points to openrouter.ai.
OPENROUTER_API_KEY=

# Requested OpenRouter free model configuration (copy into private .env):
# AI_ENABLED=true
# AI_API_FORMAT=chat_completions
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=inclusionai/ling-3.0-flash-vl:free
# AI_OUTPUT_MODE=prompt_json
# OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
# AI_PRICING_MODE=free
# AI_INPUT_USD_PER_MILLION=0
# AI_OUTPUT_USD_PER_MILLION=0
# AI_MONTHLY_BUDGET=0
# Non-streaming responses let the app validate complete JSON before saving.

# Provider examples: replace the active values above, do not duplicate keys.
# OpenAI: AI_API_FORMAT=responses; AI_BASE_URL=https://api.openai.com/v1
# OpenRouter: AI_API_FORMAT=chat_completions; AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=YOUR_PROVIDER/YOUR_MODEL_ID (copy the exact supported model ID).
# Gemini compatibility: AI_API_FORMAT=chat_completions
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_API_KEY=YOUR_GEMINI_API_KEY; AI_MODEL=YOUR_SUPPORTED_GEMINI_MODEL_ID
# Local Ollama: AI_API_FORMAT=chat_completions; AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=YOUR_INSTALLED_MODEL; AI_API_KEY= (may be blank for loopback only).
# Local means the backend machine/container, not the visitor's browser.
# Hosted free tiers still require a provider key and a schema-capable model.
# Provider documentation and full copyable examples: docs/ai-providers.md

# USDA FoodData Central API key, required for food lookup and AI meal/food flows.
# This is separate from AI_API_KEY. Obtain your own FoodData Central API key.
# Example shape: FOOD_DATA_API_KEY=YOUR_USDA_API_KEY
FOOD_DATA_API_KEY=

# Milliseconds; implementation caps AI calls at 45000 ms.
AI_TIMEOUT_MS=25000
# Maximum requests per member over a rolling 24 hours.
AI_DAILY_REQUEST_LIMIT=20

# paid (default) or free. This is cost accounting, not a provider billing switch.
# Use free only when your selected endpoint/model is actually free for your account.
AI_PRICING_MODE=paid
# USD per million tokens: enter your chosen model's verified current prices.
# Numeric format examples ONLY: 1.25 and 10.00 (not a model price quotation).
# Paid: both explicit non-negative rates, at least one > 0, monthly budget > 0.
# Free: set BOTH rates to 0 explicitly; monthly budget may be 0.
# Missing/invalid rates disable AI; they are never silently treated as free.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Application-wide monthly reservation budget in USD. 10 means $10.
# This does not configure provider-side billing limits.
# Free example: AI_PRICING_MODE=free, both token rates=0, AI_MONTHLY_BUDGET=0.
# Daily request limits still apply, even to free/local models.
AI_MONTHLY_BUDGET=10

# Set true only after qualified review of the implemented wellness-v1 policy.
# False allows previews/manual tracking but blocks target activation/diet plans.
# See docs/ai-health-setup.md for full setup details.
HEALTH_POLICY_REVIEWED=false

# --- Optional: request limits (positive whole numbers) ---

# Login and change/reset-password attempts per IP per 15 minutes.
LOGIN_RATE_LIMIT_MAX=10
# Registrations per IP per hour.
REGISTER_RATE_LIMIT_MAX=20
# Password-recovery requests per IP per hour.
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
# Avatar uploads per IP per 15 minutes.
AVATAR_UPLOAD_RATE_LIMIT_MAX=15

# Email delivery and payment gateways are not implemented. Adding SMTP_*,
# STRIPE_*, or similar keys alone will not enable reset emails or real billing.
