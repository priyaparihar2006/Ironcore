# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit it.

# NODE_ENV: "development" or "production".
# In production, JWT_SECRET becomes mandatory (the server refuses to start
# without it) and demo seed data is never created automatically.
NODE_ENV=production

# PORT: which port the Node server listens on. Most hosting platforms
# (Render, Railway, ...) inject this automatically — leave unset and let the
# platform supply it, or set it explicitly for local/VPS use.
PORT=5000

# JWT_SECRET: signs and verifies all authentication tokens. REQUIRED in
# production — the server will fail to start without it. Generate a real
# secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit your real value here.
JWT_SECRET=replace-with-a-long-random-secret

# SEED_DEMO_DATA: controls whether the built-in demo accounts/data (e.g.
# admin@ironcore.fit, AdminPassword123!) are created when the database is
# empty. Defaults to enabled in development and DISABLED in production, so
# set this to "true" only if you deliberately want a demo environment.
# SEED_DEMO_DATA=true
