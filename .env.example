# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit it.

# NODE_ENV: "development" or "production".
# In production, JWT_SECRET becomes mandatory (the server refuses to start
# without it) and demo seed data is never created automatically.
NODE_ENV=production

# PORT: which port the Node server listens on. Most hosting platforms
# (Render, Railway, ...) inject this automatically — leave unset and let the
# platform supply it, or set it explicitly for local/VPS use.
PORT=5000

# DATABASE_URL: PostgreSQL connection string for Supabase. REQUIRED to run
# the server or `npm run migrate:postgres`. Get this from your Supabase
# project: Dashboard -> Project Settings -> Database -> Connection string ->
# "Session pooler" (NOT "Direct connection" or "Transaction pooler" — the
# Session pooler is correct for this app's long-running Node/Express server
# with a persistent connection pool). Copy the URI and replace the [YOUR-
# PASSWORD] placeholder with your real database password.
# NEVER commit your real value here — this file only documents the shape.
DATABASE_URL=

# JWT_SECRET: signs and verifies all authentication tokens. REQUIRED in
# production — the server will fail to start without it. Generate a real
# secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit your real value here.
JWT_SECRET=replace-with-a-long-random-secret

# SEED_DEMO_DATA: controls whether the built-in demo accounts/data (e.g.
# admin@ironcore.fit, AdminPassword123!) are created when the database is
# empty. Defaults to enabled in development and DISABLED in production, so
# set this to "true" only if you deliberately want a demo environment.
# SEED_DEMO_DATA=true

# VITE_API_URL: used by the frontend when deployed separately (e.g. on Vercel)
# to point to the backend Express server URL (e.g. https://ironcore-api.onrender.com).
# Leave unset or empty if the frontend and backend are hosted on the same origin or proxied.
# VITE_API_URL=https://your-backend.onrender.com

# CORS_ORIGIN: comma-separated list of allowed frontend origins for CORS.
# Defaults to '*' (allows all origins). In production with separate frontend deployment,
# set this to your frontend URL (e.g. https://your-app.vercel.app).
# CORS_ORIGIN=https://your-app.vercel.app

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: REQUIRED for profile photo
# uploads (PUT /auth/profile/avatar). Uses Supabase Storage in the same
# Supabase project this app already uses for Postgres — not a separate
# service. Get both from Supabase Dashboard -> Project Settings -> API
# (SUPABASE_URL is the "Project URL"; SUPABASE_SERVICE_ROLE_KEY is the
# secret "service_role" key, NOT the public "anon" key — it's required
# server-side because uploads are authorized by this app's own JWT, not
# Supabase Auth). You must also create a PUBLIC storage bucket named
# "avatars" in that project before uploads will work. Without these,
# avatar uploads fail with a clear "storage is not configured" error;
# everything else in the app works normally.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

